{
  "name": "print-map-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "doctor": "react-doctor . --no-score --blocking warning --no-telemetry",
    "generate:administrative-boundaries": "uv run scripts/generate_administrative_boundaries.py",
    "test": "vitest",
    "test:e2e": "LIBGL_ALWAYS_SOFTWARE=1 xvfb-run -a -s '-screen 0 1440x900x24 +extension GLX +render -noreset' npm run test:e2e:release",
    "test:e2e:release": "playwright test --project=chromium --workers=1 --shard=1/3 && playwright test --project=chromium --workers=1 --shard=2/3 && playwright test --project=chromium --workers=1 --shard=3/3",
    "test:e2e:all-browsers": "npm run test:e2e:release && playwright test --project=firefox --workers=1 --shard=1/3 && playwright test --project=firefox --workers=1 --shard=2/3 && playwright test --project=firefox --workers=1 --shard=3/3 && playwright test --project=webkit --workers=1 --shard=1/3 && playwright test --project=webkit --workers=1 --shard=2/3 && playwright test --project=webkit --workers=1 --shard=3/3",
    "test:e2e:focused": "LIBGL_ALWAYS_SOFTWARE=1 xvfb-run -a -s '-screen 0 1440x900x24 +extension GLX +render -noreset' playwright test --project=chromium --workers=1"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.10",
    "@deck.gl/layers": "^9.3.10",
    "@deck.gl/mapbox": "^9.3.10",
    "@luma.gl/core": "^9.3.5",
    "@luma.gl/engine": "^9.3.5",
    "@math.gl/web-mercator": "^4.1.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.33.0",
    "maplibre-gl": "^6.4.1",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "terra-draw": "^1.32.3",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-unicorn": "73.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "react-doctor": "^0.9.12",
    "react-scan": "^0.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
