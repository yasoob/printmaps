---
import {
  ArrowUpFromLine,
  MapPin,
  MapPinPlus,
  Mountain,
  Earth,
  Route,
  Shapes,
  Timer,
} from '@lucide/astro';
import { firstPagePath } from './registry';

const capabilities = [
  { label: 'Routes', icon: Route, href: firstPagePath('route-map-poster', 'gpx-map-maker') },
  { label: 'Places', icon: MapPin, href: firstPagePath('real-estate-location-map', 'printable-map-maker') },
  { label: 'Shapes', icon: Shapes, href: firstPagePath('printable-map-maker') },
  { label: 'Regions', icon: Earth, href: firstPagePath('country-map-poster', 'printable-map-maker') },
  { label: 'Isochrones', icon: Timer, href: firstPagePath('travel-time-map') },
  { label: 'Imports', icon: ArrowUpFromLine, href: firstPagePath('gpx-map-maker') },
  { label: 'Markers', icon: MapPinPlus, href: firstPagePath('wedding-map-poster', 'printable-map-maker') },
  { label: 'Terrain', icon: Mountain, href: firstPagePath('topographic-map-maker', '3d-terrain-map-stl') },
];
---

<section class="bg-white py-12 font-inter text-[#1d1d1f] sm:py-14" aria-labelledby="map-capabilities-title">
  <div class="mx-auto w-[calc(100%_-_2rem)] max-w-[76rem]">
    <h2 id="map-capabilities-title" class="text-center text-2xl font-semibold tracking-[-0.02em] sm:text-3xl">
      Add what matters.
    </h2>
    <ul class="mt-8 grid list-none grid-cols-4 gap-x-2 gap-y-6 p-0 xl:grid-cols-8">
      {capabilities.map((item) => (
        <li>
          <a class="group flex min-h-20 flex-col items-center justify-center gap-3 text-[#86868b] no-underline transition-colors hover:text-[#0071e3] focus-visible:rounded-lg focus-visible:text-[#0071e3] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#8bb9ff]" href={item.href ?? '#features'}>
            <item.icon class="size-9" stroke-width={1.6} aria-hidden="true" />
            <span class="text-sm font-semibold">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
