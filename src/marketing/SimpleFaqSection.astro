---
type FaqItem = {
  question: string;
  answer: string;
};

type Props = {
  items: readonly FaqItem[];
};

const { items } = Astro.props;
---

<section id="faq" class="scroll-mt-8 bg-[#f5f5f7] py-18 font-inter text-[#1d1d1f] sm:py-24" aria-labelledby="homepage-faq-title">
  <div class="mx-auto w-[calc(100%_-_2rem)] max-w-[56rem]">
    <div class="text-center">
      <h2 id="homepage-faq-title" class="text-3xl font-semibold tracking-[-0.03em] sm:text-5xl">
        Frequently asked questions.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-6 text-[#6e6e73] sm:text-base">
        The essentials about creating, saving, and exporting your map.
      </p>
    </div>

    <div class="mt-10 space-y-1">
      {items.map((item, index) => (
        <details class="group" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-left [&::-webkit-details-marker]:hidden">
            <h3 class="text-base font-semibold tracking-[-0.01em] sm:text-lg">{item.question}</h3>
            <span data-accordion-icon class="grid size-7 shrink-0 place-items-center text-2xl font-light leading-none text-[#6e6e73] group-open:text-[#0071e3]" aria-hidden="true">
              <span class="group-open:hidden">+</span>
              <span class="hidden group-open:inline">-</span>
            </span>
          </summary>
          <p class="max-w-3xl pb-5 pr-12 text-sm leading-6 text-[#6e6e73] sm:text-base sm:leading-7">
            {item.answer}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
