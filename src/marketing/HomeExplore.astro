---
import { navigationGroups, pagePath } from './registry';

const groups = navigationGroups().filter((group) => group.id !== 'project');
---

{groups.length > 0 && (
  <section id="explore" class="scroll-mt-8 bg-white pb-20 font-inter text-[#1d1d1f] sm:pb-28" aria-labelledby="home-explore-title">
    <div class="mx-auto w-[calc(100%_-_2rem)] max-w-[76rem] border-t border-[#e8e8ed] pt-16 sm:pt-20">
      <h2 id="home-explore-title" class="text-2xl font-semibold tracking-[-0.03em] sm:text-3xl">
        Guides and feature pages.
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-[#6e6e73] sm:text-base">
        Each page walks through one kind of map, with the settings that matter for it.
      </p>
      <div class="mt-10 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {groups.map((group) => (
          <div>
            <h3 class="text-sm font-semibold tracking-[0.06em] text-[#86868b] uppercase">{group.label}</h3>
            <ul class="mt-3 list-none space-y-2.5 p-0">
              {group.pages.map((entry) => (
                <li>
                  <a class="text-base font-medium text-[#1d1d1f] no-underline hover:text-[#0071e3] focus-visible:rounded focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#8bb9ff]" href={pagePath(entry)}>{entry.navLabel}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
