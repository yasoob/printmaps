---
import { Info, Lightbulb, TriangleAlert } from '@lucide/astro';
import type { CalloutSection } from './types';

type Props = {
  id: string;
  section: CalloutSection;
};

const { id, section } = Astro.props;
const tone = section.tone ?? 'tip';
const Icon = tone === 'tip' ? Lightbulb : tone === 'important' ? TriangleAlert : Info;
const label = tone === 'tip' ? 'Tip' : tone === 'important' ? 'Important' : 'Note';
---

<aside class="mx-auto max-w-4xl" aria-labelledby={`${id}-title`}>
  <div class:list={[
    'grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 rounded-2xl px-5 py-6 sm:gap-x-5 sm:px-8 sm:py-8',
    tone === 'important' ? 'bg-[#fff6e5]' : 'bg-[#f0f6ff]',
  ]}>
    <Icon class:list={['mt-1 size-6 shrink-0', tone === 'important' ? 'text-[#b25e00]' : 'text-[#0071e3]']} stroke-width={1.75} aria-hidden="true" />
    <div>
      <p class="text-xs font-semibold tracking-[0.08em] text-[#6e6e73] uppercase">{label}</p>
      <h2 id={`${id}-title`} class="mt-1 text-xl font-semibold tracking-[-0.02em] sm:text-2xl">{section.title}</h2>
      {section.paragraphs.map((paragraph) => <p class="mt-3 text-base leading-7 text-[#3a3a3c]">{paragraph}</p>)}
      {section.link && (
        <a class="mt-4 inline-block text-sm font-semibold text-[#0071e3] underline decoration-[#b9d7f7] underline-offset-4 hover:decoration-[#0071e3]" href={section.link.href}>{section.link.label}</a>
      )}
    </div>
  </div>
</aside>
