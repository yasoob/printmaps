---
import SectionFigure from './SectionFigure.astro';
import SectionIntro from './SectionIntro.astro';
import type { ExampleSection } from './types';

type Props = {
  id: string;
  section: ExampleSection;
};

const { id, section } = Astro.props;
---

<div class="mx-auto max-w-[68rem]">
  <div class="max-w-4xl">
    <SectionIntro id={id} title={section.title} paragraphs={section.paragraphs} />
  </div>
  <div class="mt-10 grid items-start gap-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-12">
    <SectionFigure image={section.image} />
    <ol class="list-none space-y-6 p-0">
      {section.notes.map((note, index) => (
        <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3">
          <span class="grid size-8 place-items-center rounded-full border border-[#0071e3] text-sm font-semibold text-[#0071e3]" aria-hidden="true">{index + 1}</span>
          <div>
            <h3 class="text-base font-semibold tracking-[-0.01em]">{note.title}</h3>
            <p class="mt-1 text-sm leading-6 text-[#515154]">{note.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</div>
