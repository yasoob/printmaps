---
import type { SectionImage } from './types';

type Props = {
  image: SectionImage;
  class?: string;
  eager?: boolean;
};

const { image, class: className, eager = false } = Astro.props;
---

<figure class:list={['min-w-0', className]}>
  <div class="overflow-hidden rounded-xl border border-[#d2d2d7] bg-white">
    <picture class="block">
      {image.mobileSrc && <source media="(max-width: 640px)" srcset={image.mobileSrc} width={image.mobileWidth} height={image.mobileHeight} />}
      <img
        class="h-auto w-full"
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    </picture>
  </div>
  {(image.title || image.caption) && (
    <figcaption class="mt-3 text-left">
      {image.title && <strong class="block text-sm font-semibold text-[#1d1d1f]">{image.title}</strong>}
      {image.caption && <span class="mt-1 block text-xs leading-5 text-[#6e6e73]">{image.caption}</span>}
    </figcaption>
  )}
</figure>
