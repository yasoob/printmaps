---
import {
  ArrowRight,
  BookOpenText,
  Building2,
  CalendarCheck,
  House,
  Images,
  Route,
} from '@lucide/astro';
import { firstPage, pagePath } from './registry';

const useCases = [
  {
    icon: BookOpenText,
    title: 'Design and publishing',
    body: 'Create maps for brochures, guidebooks, reports, magazines and presentations. Match an exact page size, cut the visual clutter and export a file that drops into the surrounding layout.',
    page: firstPage('layered-map-export'),
  },
  {
    icon: Route,
    title: 'Routes and trails',
    body: 'Turn a hike, ride, run or visitor route into a printable map. Draw the route or import a recorded track, mark the stops, and download its elevation profile alongside.',
    page: firstPage('route-map-poster', 'gpx-map-maker'),
  },
  {
    icon: House,
    title: 'Real estate maps',
    body: 'Put a property in its neighbourhood. Add nearby schools, shops and stations from a spreadsheet, outline the district and show how far a 15-minute walk reaches.',
    page: firstPage('real-estate-location-map'),
  },
  {
    icon: CalendarCheck,
    title: 'Events and wayfinding',
    body: 'Show entrances, venues, parking, transport stops and event boundaries on one page that stays easy to read on programmes, posters and handouts.',
    page: firstPage('wedding-map-poster', 'printable-map-maker'),
  },
  {
    icon: Images,
    title: 'Posters and gifts',
    body: 'Make wall art of a home town, the city where you met, or a road trip with photos from each stop. Pick a style that suits the room, then preview it in a frame.',
    page: firstPage('city-map-poster', 'travel-map-with-photos'),
  },
  {
    icon: Building2,
    title: 'Planning and site context',
    body: 'Combine a base map with administrative boundaries, custom shapes, travel-time areas and markers to explain access and surroundings in a static report.',
    page: firstPage('travel-time-map'),
  },
];
---

<section id="use-cases" class="scroll-mt-8 bg-white py-20 font-inter text-[#1d1d1f] sm:py-28" aria-labelledby="home-use-cases-title">
  <div class="mx-auto w-[calc(100%_-_2rem)] max-w-[76rem]">
    <div class="max-w-3xl">
      <h2 id="home-use-cases-title" class="text-2xl font-semibold tracking-[-0.03em] sm:text-3xl lg:text-4xl">
        Maps for print, publishing, and planning.
      </h2>
      <p class="mt-4 max-w-2xl text-sm leading-6 text-[#6e6e73] sm:text-base">
        The same editor handles a wedding gift, a trail guide and a property flyer.
      </p>
    </div>

    <div class="mt-14 grid gap-x-14 gap-y-14 md:grid-cols-2 lg:mt-18 lg:grid-cols-3 lg:gap-y-18">
      {useCases.map((item) => (
        <article class="flex flex-col">
          <item.icon class="size-8 text-[#0071e3]" stroke-width={1.6} aria-hidden="true" />
          <h3 class="mt-3 text-2xl font-semibold tracking-[-0.025em]">{item.title}</h3>
          <p class="mt-4 text-sm leading-6 text-[#6e6e73]">{item.body}</p>
          {item.page && (
            <a class="mt-4 inline-flex w-max items-center gap-1.5 text-sm font-semibold text-[#0071e3] no-underline hover:underline focus-visible:rounded focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#8bb9ff]" href={pagePath(item.page)}>
              {item.page.navLabel}
              <ArrowRight class="size-4" stroke-width={2} aria-hidden="true" />
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
