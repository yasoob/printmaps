---
type FeatureIcon =
  | 'a-series'
  | 'browser'
  | 'color-edit'
  | 'dimensions'
  | 'download'
  | 'fit'
  | 'geojson'
  | 'gpx'
  | 'import'
  | 'kml'
  | 'language'
  | 'layer-labels'
  | 'layers'
  | 'layout'
  | 'marker'
  | 'no-account'
  | 'orientation'
  | 'palette'
  | 'pdf-reader'
  | 'pixels'
  | 'print'
  | 'psd-file'
  | 'region'
  | 'route'
  | 'separate-elements'
  | 'share'
  | 'smart-object'
  | 'svg-editor'
  | 'text-scale'
  | 'tiles'
  | 'transform'
  | 'us-letter'
  | 'validation'
  | 'visibility';

type Props = {
  items: readonly {
    icon: FeatureIcon;
    label: string;
  }[];
  label: string;
};

const { items, label } = Astro.props;
---

<ul class="mt-8 grid list-none grid-cols-2 gap-x-5 gap-y-8 p-0 sm:grid-cols-4" aria-label={label}>
  {items.map((item) => (
    <li class="text-center">
      <span class="mx-auto grid size-10 place-items-center text-[#0071e3]" aria-hidden="true">
        {item.icon === 'palette' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a9 9 0 0 0 0 18h1.5a2 2 0 0 0 0-4H12a2 2 0 0 1 0-4h3a6 6 0 0 0 0-12Z"></path>
            <circle cx="7.5" cy="10" r="1"></circle>
            <circle cx="9.5" cy="6.5" r="1"></circle>
            <circle cx="14" cy="6.5" r="1"></circle>
            <circle cx="17" cy="9.5" r="1"></circle>
          </svg>
        )}
        {item.icon === 'language' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"></path>
          </svg>
        )}
        {item.icon === 'text-scale' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 6h10M9 6v12M6 18h6M16 10h4M18 10v8M16 18h4"></path>
          </svg>
        )}
        {item.icon === 'visibility' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2.5 12s3.5-5 9.5-5 9.5 5 9.5 5-3.5 5-9.5 5-9.5-5-9.5-5Z"></path>
            <circle cx="12" cy="12" r="2.5"></circle>
          </svg>
        )}
        {item.icon === 'a-series' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="8" y="3" width="11" height="16" rx="1"></rect>
            <path d="M5 6H3v15h11v-2M11 7h5M11 11h5M11 15h3"></path>
          </svg>
        )}
        {item.icon === 'us-letter' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h8l4 4v14H6Z"></path>
            <path d="M14 3v5h5M9 13h6M9 17h4"></path>
          </svg>
        )}
        {item.icon === 'orientation' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="7" height="16" rx="1"></rect>
            <rect x="13" y="8" width="8" height="12" rx="1"></rect>
            <path d="m12 5 2-2 2 2M14 3v3"></path>
          </svg>
        )}
        {item.icon === 'dimensions' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="6" y="6" width="12" height="12" rx="1"></rect>
            <path d="M4 6H2m2 12H2M3 6v12M2 9l1-3 1 3M2 15l1 3 1-3M6 4V2m12 2V2M6 3h12M9 2 6 3l3 1M15 2l3 1-3 1"></path>
          </svg>
        )}
        {item.icon === 'route' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="5" cy="18" r="2"></circle>
            <circle cx="19" cy="6" r="2"></circle>
            <path d="M7 18h2a4 4 0 0 0 4-4v-4a4 4 0 0 1 4-4"></path>
          </svg>
        )}
        {item.icon === 'marker' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21s7-5.2 7-12a7 7 0 1 0-14 0c0 6.8 7 12 7 12Z"></path>
            <circle cx="12" cy="9" r="2.5"></circle>
          </svg>
        )}
        {item.icon === 'region' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m4 7 5-4 5 3 5-2 2 6-3 4 1 6-7-2-5 3-4-5Z"></path>
            <path d="m9 3 1 6 4 3 4 2"></path>
          </svg>
        )}
        {item.icon === 'import' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h8l4 4v5M14 3v5h5"></path>
            <path d="M12 11v9m-4-4 4 4 4-4M5 21h14"></path>
          </svg>
        )}
        {item.icon === 'gpx' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h8l4 4v14H6Z"></path>
            <path d="M14 3v5h5M9 17c0-3 2-5 5-5M9 17h.01M14 12h.01"></path>
          </svg>
        )}
        {item.icon === 'kml' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h8l4 4v14H6Z"></path>
            <path d="M14 3v5h5"></path>
            <circle cx="12" cy="15" r="3.5"></circle>
            <path d="M8.5 15h7M12 11.5a6 6 0 0 1 0 7M12 11.5a6 6 0 0 0 0 7"></path>
          </svg>
        )}
        {item.icon === 'geojson' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h8l4 4v14H6Z"></path>
            <path d="M14 3v5h5M11 11c-1 0-1.5.5-1.5 1.5V14c0 .7-.5 1-1 1 .5 0 1 .3 1 1v1.5c0 1 .5 1.5 1.5 1.5M13 11c1 0 1.5.5 1.5 1.5V14c0 .7.5 1 1 1-.5 0-1 .3-1 1v1.5c0 1-.5 1.5-1.5 1.5"></path>
          </svg>
        )}
        {item.icon === 'validation' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 20 6v6c0 4.5-3.2 7.5-8 9-4.8-1.5-8-4.5-8-9V6Z"></path>
            <path d="m8.5 12 2.3 2.3 4.7-4.8"></path>
          </svg>
        )}
        {item.icon === 'layers' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3 9 5-9 5-9-5Z"></path>
            <path d="m3 12 9 5 9-5M3 16l9 5 9-5"></path>
          </svg>
        )}
        {item.icon === 'fit' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"></path>
            <path d="M6 16c2-5 5-7 12-8"></path>
            <circle cx="6" cy="16" r="1.5"></circle>
            <circle cx="18" cy="8" r="1.5"></circle>
          </svg>
        )}
        {item.icon === 'save' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 3h12l2 2v16H5Z"></path>
            <path d="M8 3v6h8V3M8 21v-7h8v7"></path>
          </svg>
        )}
        {item.icon === 'pixels' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="currentColor">
            <rect x="3" y="3" width="5" height="5" rx="0.75"></rect>
            <rect x="9.5" y="3" width="5" height="5" rx="0.75" opacity="0.75"></rect>
            <rect x="16" y="3" width="5" height="5" rx="0.75" opacity="0.5"></rect>
            <rect x="3" y="9.5" width="5" height="5" rx="0.75" opacity="0.75"></rect>
            <rect x="9.5" y="9.5" width="5" height="5" rx="0.75" opacity="0.5"></rect>
            <rect x="16" y="9.5" width="5" height="5" rx="0.75" opacity="0.75"></rect>
            <rect x="3" y="16" width="5" height="5" rx="0.75" opacity="0.5"></rect>
            <rect x="9.5" y="16" width="5" height="5" rx="0.75" opacity="0.75"></rect>
            <rect x="16" y="16" width="5" height="5" rx="0.75"></rect>
          </svg>
        )}
        {item.icon === 'tiles' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="8" height="8" rx="1"></rect>
            <rect x="13" y="3" width="8" height="8" rx="1"></rect>
            <rect x="3" y="13" width="8" height="8" rx="1"></rect>
            <rect x="13" y="13" width="8" height="8" rx="1"></rect>
          </svg>
        )}
        {item.icon === 'print' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 8V3h10v5M7 17H5a2 2 0 0 1-2-2v-5h18v5a2 2 0 0 1-2 2h-2"></path>
            <path d="M7 14h10v7H7Z"></path>
            <circle cx="17.5" cy="12.5" r=".5" fill="currentColor"></circle>
          </svg>
        )}
        {item.icon === 'smart-object' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h8l4 4v14H6Z"></path>
            <path d="M14 3v5h5"></path>
            <path d="m12 11 4 4-4 4-4-4Z"></path>
            <circle cx="12" cy="15" r="1"></circle>
          </svg>
        )}
        {item.icon === 'browser' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
            <path d="M3 9h18"></path>
            <circle cx="6" cy="6.5" r=".5" fill="currentColor"></circle>
            <circle cx="8.5" cy="6.5" r=".5" fill="currentColor"></circle>
          </svg>
        )}
        {item.icon === 'download' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v12m-5-5 5 5 5-5M4 19v2h16v-2"></path>
          </svg>
        )}
        {item.icon === 'no-account' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="3"></circle>
            <path d="M5 20c.8-4 3-6 7-6s6.2 2 7 6M4 4l16 16"></path>
          </svg>
        )}
        {item.icon === 'share' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="2.5"></circle>
            <circle cx="6" cy="12" r="2.5"></circle>
            <circle cx="18" cy="19" r="2.5"></circle>
            <path d="m8.2 10.8 7.6-4.5M8.2 13.2l7.6 4.5"></path>
          </svg>
        )}
        {item.icon === 'layout' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="1.5"></rect>
            <rect x="6" y="6" width="7" height="9" rx="1"></rect>
            <path d="M16 7h2M16 11h2M16 15h2M6 18h12"></path>
          </svg>
        )}
        {item.icon === 'pdf-reader' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
            <path d="M3 9h18M9 12h6M9 15h6M9 18h4"></path>
          </svg>
        )}
        {item.icon === 'color-edit' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 17c4-7 8-8 13-8"></path>
            <circle cx="3" cy="17" r="1.5"></circle>
            <circle cx="16" cy="9" r="1.5"></circle>
            <path d="M19 13s2 2.4 2 4a2 2 0 0 1-4 0c0-1.6 2-4 2-4Z"></path>
          </svg>
        )}
        {item.icon === 'transform' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="6" y="6" width="12" height="12"></rect>
            <path d="M3 3h5M3 3v5M21 21h-5M21 21v-5M3 21l5-5M21 3l-5 5"></path>
          </svg>
        )}
        {item.icon === 'svg-editor' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h8l4 4v14H6Z"></path>
            <path d="M14 3v5h5M11 12l-2 2 2 2M13 12l2 2-2 2"></path>
          </svg>
        )}
        {item.icon === 'psd-file' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h8l4 4v14H6Z"></path>
            <path d="M14 3v5h5"></path>
            <text x="12" y="17" text-anchor="middle" font-family="Arial, sans-serif" font-size="7" font-weight="700" fill="currentColor" stroke="none">Ps</text>
          </svg>
        )}
        {item.icon === 'layer-labels' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m8 4 6 3-6 3-6-3ZM8 11l6 3-6 3-6-3Z"></path>
            <path d="M16 7h6M16 10h4M16 14h6M16 17h4"></path>
          </svg>
        )}
        {item.icon === 'separate-elements' && (
          <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="6" cy="7" r="3"></circle>
            <rect x="15" y="4" width="6" height="6" rx="1"></rect>
            <path d="m5 21 4-7 4 7ZM17 14l4 7h-8Z"></path>
          </svg>
        )}
      </span>
      <span class="mt-3 block text-sm font-semibold leading-5 text-[#3a3a3c]">{item.label}</span>
    </li>
  ))}
</ul>
