---
import HeroEditorPreview from './HeroEditorPreview.astro';
import MarketingHeader from './MarketingHeader.astro';
---

<section class="min-h-svh overflow-hidden bg-[#f5f5f7] font-inter text-[#1d1d1f]">
  <MarketingHeader />

  <div class="mx-auto w-[calc(100%_-_2rem)] max-w-[88rem] pt-22 text-center max-md:w-full max-md:pt-18">
    <div class="max-md:px-5">
      <span class="text-[0.7rem] font-semibold tracking-[0.1em] text-[#6e6e73] uppercase">
        Free · no account · no watermark
      </span>
      <h1 class="mx-auto mt-3.5 max-w-5xl text-4xl leading-[0.98] font-bold tracking-[-0.025em] sm:text-5xl lg:text-6xl">
        Map posters and printable maps, made in your browser.
      </h1>
      <p class="mx-auto mt-5.5 max-w-3xl text-[1.05rem] leading-[1.55] text-[#6e6e73] max-md:text-[0.9rem]">
        Pick a place and an exact paper size, choose one of 12 map styles, then add routes, places, photos and a title. Download a 300 dpi PNG or a PDF for the printer, or a layered SVG or PSD to keep editing.
      </p>
      <a class="mt-7 inline-flex min-h-12 items-center justify-center rounded-full bg-[#0071e3] px-6 text-sm font-semibold text-white no-underline transition hover:-translate-y-0.5 hover:bg-[#0077ed] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#8bb9ff] motion-reduce:transition-none" href="/editor/">
        Open the editor - it's free
      </a>
    </div>
    <HeroEditorPreview class="mx-auto mt-12 w-full max-w-[76rem] max-md:mt-10 max-md:w-[calc(100%_-_1rem)]" />
  </div>
</section>
