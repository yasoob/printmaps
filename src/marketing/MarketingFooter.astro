---
import {
  CREATOR_NAME,
  CREATOR_URL,
  GITHUB_URL,
  SITE_NAME,
} from './product';
import { navigationGroups, pagePath, pagesInGroup } from './registry';

const year = new Date().getFullYear();
const contentGroups = navigationGroups().filter((group) => group.id !== 'project');
const projectLinks = [
  { href: '/editor/', label: 'Open the editor' },
  ...pagesInGroup('project').map((entry) => ({ href: pagePath(entry), label: entry.navLabel })),
  { href: GITHUB_URL, label: 'Source code on GitHub' },
];
const linkClass = 'text-sm font-medium text-[#6e6e73] no-underline hover:text-[#0071e3] focus-visible:rounded focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#8bb9ff]';
---

<footer class="bg-white px-4 pt-24 pb-4 font-inter text-[#1d1d1f] sm:px-8 sm:pt-32">
  <div class="mx-auto max-w-[76rem]">
    <div class="flex items-start justify-between gap-16 max-lg:flex-col max-lg:gap-12">
      <div class="shrink-0">
        <a class="flex w-max items-center gap-3 text-xl font-semibold tracking-[-0.03em] text-[#1d1d1f] no-underline focus-visible:rounded focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#8bb9ff] sm:gap-5 sm:text-3xl" href="/" aria-label={`${SITE_NAME} home`}>
          <img class="h-auto w-14 border-0! sm:w-22" src="/logo.png" alt="" width="88" height="59" loading="lazy" />
          <span>{SITE_NAME}</span>
        </a>
        <p class="mt-3 max-w-xs text-sm leading-6 text-[#6e6e73] sm:mt-5 sm:text-lg">Free print-ready maps and map posters, made in your browser.</p>
      </div>
      <div class="grid w-full max-w-[56rem] grid-cols-2 gap-x-8 gap-y-10 pt-4 sm:grid-cols-3 lg:grid-cols-5">
        {contentGroups.map((group) => (
          <nav class="grid content-start gap-3.5" aria-label={`${group.label} pages`}>
            <h2 class="text-sm font-semibold text-[#1d1d1f]">{group.label}</h2>
            {group.pages.map((entry) => <a class={linkClass} href={pagePath(entry)}>{entry.navLabel}</a>)}
          </nav>
        ))}
        <nav class="grid content-start gap-3.5" aria-label="Project navigation">
          <h2 class="text-sm font-semibold text-[#1d1d1f]">Project</h2>
          {projectLinks.map((item) => <a class={linkClass} href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </div>
    <div class="flex justify-between gap-8 pt-32 text-sm text-[#6e6e73] max-md:flex-col">
      <span>
        &copy; {year} {SITE_NAME}. Created by <a class="font-medium underline decoration-[#d2d2d7] underline-offset-4 hover:text-[#0071e3]" href={CREATOR_URL}>{CREATOR_NAME}</a>.
      </span>
      <span>
        Map data &copy; <a class="font-medium underline decoration-[#d2d2d7] underline-offset-4 hover:text-[#0071e3]" href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>
      </span>
    </div>
  </div>
</footer>
