---
import InlineText from './InlineText.astro';
import { Check } from '@lucide/astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ExportFormatRow from './ExportFormatRow.astro';
import MarketingLayout from './MarketingLayout.astro';
import SimpleFaqSection from './SimpleFaqSection.astro';
import type { MarketingImage } from './media';
import { SITE_NAME } from './product';
import {
  fullTitle,
  ogImageFor,
  pageKind,
  pagePath,
  relatedPages,
  type MarketingPageEntry,
} from './registry';
import { responsiveSrcset } from './responsiveImage';
import SectionRenderer from './sections/SectionRenderer.astro';
import type { PageSection } from './sections/types';
import { pageGraph } from './structuredData';

export type { PageSection } from './sections/types';

type FaqItem = {
  question: string;
  answer: string;
};

type LegacyHeroImage = {
  alt: string;
  desktopAspect?: '16:10' | '2000:1155';
  desktopHeight?: number;
  desktopSrc: string;
  desktopWidth?: number;
  mobileSrc: string;
};

type RelatedLink = {
  href: string;
  label: string;
  description: string;
};

type Props = {
  /** Registry entry for this page. Supplies title, description, breadcrumbs, OG image and related links. */
  page?: MarketingPageEntry;
  /** Required when `page` is omitted; overrides `page.title` otherwise. */
  title?: string;
  description?: string;
  eyebrow: string;
  heading: string;
  lead: string;
  primaryCta: string;
  /** Second hero button. Defaults to "See how it works" (#how-it-works); `false` hides it. */
  secondaryCta?: { href: string; label: string } | false;
  facts?: readonly string[];
  /**
   * Hero image. Media entries (`media['key']`) and the legacy `{ desktopSrc, mobileSrc }`
   * shape both work. Omit it for a text-only hero.
   */
  heroImage?: MarketingImage | LegacyHeroImage;
  /** `stacked` (default): centered text with a wide screenshot below. `split`: text left, image right. */
  heroLayout?: 'stacked' | 'split';
  /** Link the hero image to the editor (default true for stacked screenshots). */
  heroLinksToEditor?: boolean;
  showHeroExportFormats?: boolean;
  sections: readonly PageSection[];
  /** Heading of the closing call-to-action band. Required and page-specific. */
  ctaHeading: string;
  /** Defaults to related registry pages. */
  relatedLinks?: readonly RelatedLink[];
  relatedTitle?: string;
  faq?: readonly FaqItem[];
  faqTitle?: string;
  /** Subtitle under the FAQ heading. Required when `faq` has items. */
  faqDescription?: string;
  /** Show the visible breadcrumb trail (default true when `page` is set). */
  showBreadcrumbs?: boolean;
  ogImage?: MarketingImage;
};

const {
  page,
  eyebrow,
  heading,
  lead,
  primaryCta,
  secondaryCta = { href: '#how-it-works', label: 'See how it works' },
  facts = [],
  heroImage,
  heroLayout = 'stacked',
  showHeroExportFormats = false,
  sections,
  relatedTitle = 'More ways to use Print Map Studio.',
  faq = [],
  faqTitle = 'Common questions.',
  showBreadcrumbs = Boolean(page),
} = Astro.props;

const title = Astro.props.title ?? page?.title;
const { ctaHeading, faqDescription } = Astro.props;
if (!ctaHeading) throw new Error(`${Astro.url.pathname} needs a page-specific \`ctaHeading\`.`);
if (faq.length > 0 && !faqDescription) throw new Error(`${Astro.url.pathname} needs a page-specific \`faqDescription\` for its FAQ.`);
const description = Astro.props.description ?? page?.description;
if (!title || !description) throw new Error('SeoLandingPage needs a `page` entry or explicit `title` and `description`.');
if (page && pagePath(page) !== Astro.url.pathname) {
  throw new Error(`Registry entry "${page.slug}" is rendered at ${Astro.url.pathname}; the slug must match the route.`);
}

const hero = heroImage && ('desktopSrc' in heroImage
  ? {
      src: heroImage.desktopSrc,
      width: heroImage.desktopWidth ?? 1440,
      height: heroImage.desktopHeight ?? 900,
      alt: heroImage.alt,
      mobileSrc: heroImage.mobileSrc,
      aspectClass: heroImage.desktopAspect === '2000:1155' ? 'sm:aspect-[2000/1155]' : 'sm:aspect-[16/10]',
      legacy: true,
    }
  : { ...heroImage, aspectClass: '', legacy: false });
const heroSrcset = hero ? responsiveSrcset(hero.src, hero.width) : undefined;
const heroMobileWidth = hero && 'mobileWidth' in hero ? hero.mobileWidth : undefined;
const heroMobileSrcset = hero?.mobileSrc && heroMobileWidth ? responsiveSrcset(hero.mobileSrc, heroMobileWidth) ?? hero.mobileSrc : hero?.mobileSrc;
// On phones the hero sits below the heading and lead, so it is not the LCP element there.
const heroLinksToEditor = Astro.props.heroLinksToEditor ?? heroLayout === 'stacked';
const ogImage = Astro.props.ogImage ?? ogImageFor(page?.slug ?? Astro.url.pathname.replace(/^\/|\/$/g, ''), page?.ogImage);
const relatedLinks: readonly RelatedLink[] = Astro.props.relatedLinks
  ?? (page ? relatedPages(page).map((entry) => ({ href: pagePath(entry), label: entry.navLabel, description: entry.cardBlurb ?? entry.description })) : []);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const structuredData = page
  ? pageGraph({ entry: page, title: fullTitle(title), description, image: ogImage })
  : {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      name: fullTitle(title),
      url: canonicalUrl,
      description,
    };
const breadcrumbs = page ? [{ name: 'Home', href: '/' }, { name: page.navLabel }] : [];

function sectionId(section: PageSection, index: number): string {
  if (section.id) return section.id;
  const slug = section.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  return slug || `section-${index + 1}`;
}
---


<MarketingLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType={page && pageKind(page) === 'guide' ? 'article' : 'website'}
  structuredData={structuredData}
>
  <section class:list={[
    'overflow-hidden bg-[#f5f5f7] px-4 pt-14 font-inter text-[#1d1d1f] sm:px-8 sm:pt-20',
    (!hero || heroLayout === 'split') && 'pb-16 sm:pb-24',
  ]}>
    <div class:list={[
      'mx-auto max-w-[76rem]',
      heroLayout === 'split' && hero ? 'grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-16' : 'text-center',
    ]}>
      <div>
        {showBreadcrumbs && breadcrumbs.length > 0 && (
          <Breadcrumbs class:list={['mb-8', heroLayout === 'split' && hero ? '' : '[&_ol]:justify-center']} items={breadcrumbs} />
        )}
        <span class="text-[0.72rem] font-semibold tracking-[0.1em] text-[#6e6e73] uppercase">{eyebrow}</span>
        <h1 class:list={[
          'mt-4 text-4xl leading-[0.95] font-semibold tracking-[-0.045em] sm:text-5xl lg:text-6xl',
          heroLayout === 'split' && hero ? 'max-w-2xl' : 'mx-auto max-w-5xl',
        ]}>
          {heading}
        </h1>
        <p class:list={[
          'mt-7 text-base leading-7 text-[#6e6e73] sm:text-xl sm:leading-8',
          heroLayout === 'split' && hero ? 'max-w-xl' : 'mx-auto max-w-3xl',
        ]}>
          <InlineText text={lead} />
        </p>
        <div class:list={['mt-8 flex flex-wrap items-center gap-3', !(heroLayout === 'split' && hero) && 'justify-center']}>
          <a class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#0071e3] px-6 text-sm font-semibold text-white no-underline transition hover:-translate-y-0.5 hover:bg-[#0077ed] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#8bb9ff] motion-reduce:transition-none" href="/editor/">
            {primaryCta}
          </a>
          {secondaryCta && (
            <a class="inline-flex min-h-12 items-center justify-center rounded-full border border-[#d2d2d7] bg-white px-6 text-sm font-semibold text-[#1d1d1f] no-underline hover:border-[#86868b] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#8bb9ff]" href={secondaryCta.href}>
              {secondaryCta.label}
            </a>
          )}
        </div>
        {facts.length > 0 && (
          <ul class:list={[
            'mt-7 flex max-w-3xl list-none flex-wrap gap-x-6 gap-y-2 p-0 text-sm font-medium text-[#6e6e73]',
            !(heroLayout === 'split' && hero) && 'mx-auto justify-center',
          ]}>
            {facts.map((fact) => (
              <li class="inline-flex items-center gap-1.5">
                <Check class="size-4 text-[#0071e3]" stroke-width={2.25} aria-hidden="true" />
                {fact}
              </li>
            ))}
          </ul>
        )}
        {showHeroExportFormats && <ExportFormatRow class:list={['mt-8', !(heroLayout === 'split' && hero) && 'mx-auto']} eager />}
      </div>
      {hero && heroLayout === 'split' && (
        <figure class="overflow-hidden rounded-xl border border-[#d2d2d7] bg-white shadow-[0_1.5rem_4rem_rgba(0,0,0,0.12)]">
          <picture class="block">
            {heroMobileSrcset && <source media="(max-width: 640px)" srcset={heroMobileSrcset} sizes="calc(100vw - 2rem)" />}
            <img class="h-auto w-full" src={hero.src} srcset={heroSrcset} sizes={heroSrcset ? '(min-width: 64rem) 38rem, calc(100vw - 2rem)' : undefined} alt={hero.alt} width={hero.width} height={hero.height} loading="eager" />
          </picture>
        </figure>
      )}
      {hero && heroLayout === 'stacked' && (() => {
        const Wrapper = heroLinksToEditor ? 'a' : 'div';
        return (
          <Wrapper
            class:list={[
              'group relative mx-auto mt-14 block max-w-[68rem] overflow-hidden rounded-t-xl border border-b-0 border-[#d2d2d7] bg-white',
              heroLinksToEditor && 'focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-[#8bb9ff]',
            ]}
            href={heroLinksToEditor ? '/editor/' : undefined}
            aria-label={heroLinksToEditor ? `Open ${SITE_NAME} editor` : undefined}
          >
            <picture class="block">
              {heroMobileSrcset && <source media="(max-width: 640px)" srcset={heroMobileSrcset} sizes="calc(100vw - 2rem)" type={hero.legacy ? 'image/webp' : undefined} />}
              <img
                class:list={['w-full', hero.legacy ? 'object-cover object-top max-sm:aspect-[13/14]' : 'h-auto', hero.aspectClass]}
                src={hero.src}
                srcset={heroSrcset}
                sizes={heroSrcset ? '(min-width: 70rem) 68rem, calc(100vw - 2rem)' : undefined}
                alt={hero.alt}
                width={hero.width}
                height={hero.height}
                loading="eager"
              />
            </picture>
          </Wrapper>
        );
      })()}
    </div>
  </section>

  <section id="how-it-works" class="scroll-mt-8 bg-white px-4 py-20 font-inter text-[#1d1d1f] sm:px-8 sm:py-28">
    <div class="mx-auto max-w-[68rem]">
      {sections.map((section, index) => {
        const id = sectionId(section, index);
        return (
          <article id={id} class="scroll-mt-8 py-12 md:py-16" aria-labelledby={`${id}-title`}>
            <SectionRenderer id={id} section={section} />
          </article>
        );
      })}
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-[#0071e3] px-4 py-20 font-inter text-white before:pointer-events-none before:absolute before:inset-0 before:z-0 before:bg-[url('/noise.svg')] before:opacity-50 before:content-[''] sm:px-8 sm:py-24">
    <div class="relative z-10 mx-auto max-w-[68rem] text-center">
      <p class="text-sm font-semibold tracking-[0.08em] text-white/70 uppercase">Ready to start?</p>
      <h2 class="mx-auto mt-4 max-w-3xl text-3xl font-semibold tracking-[-0.035em] sm:text-4xl lg:text-5xl">{ctaHeading}</h2>
      <a class="mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-white px-6 text-sm font-semibold text-[#0071e3] no-underline transition hover:-translate-y-0.5 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-white motion-reduce:transition-none" href="/editor/">
        {primaryCta}
      </a>
    </div>
  </section>

  {relatedLinks.length > 0 && (
    <section class="bg-white px-4 py-20 font-inter text-[#1d1d1f] sm:px-8 sm:py-24" aria-labelledby="related-pages-title">
      <div class="mx-auto max-w-[68rem]">
        <h2 id="related-pages-title" class="text-2xl font-semibold tracking-[-0.03em] sm:text-3xl lg:text-4xl">{relatedTitle}</h2>
        <div class="mt-10 grid gap-3 md:grid-cols-2">
          {relatedLinks.map((link) => (
            <a class="group rounded-xl bg-[#f5f5f7] px-6 py-5 no-underline focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#8bb9ff]" href={link.href}>
              <h3 class="text-xl font-semibold tracking-[-0.02em] group-hover:text-[#0071e3]">{link.label}</h3>
              <p class="mt-2 text-sm leading-6 text-[#6e6e73]">{link.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {faq.length > 0 && (
    <SimpleFaqSection
      id="questions"
      title={faqTitle}
      description={faqDescription}
      items={faq}
    />
  )}
</MarketingLayout>
