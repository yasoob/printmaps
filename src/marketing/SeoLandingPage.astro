---
import ExportFormatRow from './ExportFormatRow.astro';
import FeatureIconGrid from './FeatureIconGrid.astro';
import MarketingLayout from './MarketingLayout.astro';
import SimpleFaqSection from './SimpleFaqSection.astro';
import { SITE_NAME, SITE_URL } from './product';

type FaqItem = {
  question: string;
  answer: string;
};

type SectionImage = {
  alt: string;
  caption: string;
  height: number;
  src: string;
  title: string;
  width: number;
};

type PageSection = {
  highlights?: readonly {
    icon:
      | 'a-series'
      | 'browser'
      | 'color-edit'
      | 'dimensions'
      | 'download'
      | 'fit'
      | 'geojson'
      | 'gpx'
      | 'import'
      | 'kml'
      | 'language'
      | 'layer-labels'
      | 'layers'
      | 'layout'
      | 'marker'
      | 'no-account'
      | 'orientation'
      | 'palette'
      | 'pdf-reader'
      | 'pixels'
      | 'print'
      | 'psd-file'
      | 'region'
      | 'route'
      | 'separate-elements'
      | 'share'
      | 'smart-object'
      | 'svg-editor'
      | 'text-scale'
      | 'tiles'
      | 'transform'
      | 'us-letter'
      | 'validation'
      | 'visibility';
    label: string;
  }[];
  image?: SectionImage;
  imageRow?: readonly SectionImage[];
  showExportFormats?: boolean;
  title: string;
  paragraphs: readonly string[];
  points?: readonly string[];
};

type RelatedLink = {
  href: string;
  label: string;
  description: string;
};

type Props = {
  description: string;
  eyebrow: string;
  facts: readonly string[];
  faq: readonly FaqItem[];
  heading: string;
  heroImage: {
    alt: string;
    desktopSrc: string;
    mobileSrc: string;
  };
  lead: string;
  primaryCta: string;
  relatedLinks: readonly RelatedLink[];
  sections: readonly PageSection[];
  showHeroExportFormats?: boolean;
  title: string;
};

const {
  description,
  eyebrow,
  facts,
  faq,
  heading,
  heroImage,
  lead,
  primaryCta,
  relatedLinks,
  sections,
  showHeroExportFormats = false,
  title,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  name: `${title} | ${SITE_NAME}`,
  url: canonicalUrl,
  description,
  isPartOf: {
    '@id': `${SITE_URL}/#website`,
  },
  about: {
    '@id': `${SITE_URL}/#application`,
  },
};
---

<MarketingLayout title={title} description={description} structuredData={structuredData}>
  <section class="overflow-hidden bg-[#f5f5f7] px-4 pt-20 font-inter text-[#1d1d1f] sm:px-8 sm:pt-28">
    <div class="mx-auto max-w-[76rem] text-center">
      <span class="text-[0.72rem] font-semibold tracking-[0.1em] text-[#6e6e73] uppercase">{eyebrow}</span>
      <h1 class="mx-auto mt-4 max-w-5xl text-4xl leading-[0.95] font-semibold tracking-[-0.045em] sm:text-5xl lg:text-6xl">
        {heading}
      </h1>
      <p class="mx-auto mt-7 max-w-3xl text-base leading-7 text-[#6e6e73] sm:text-xl sm:leading-8">
        {lead}
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#0071e3] px-6 text-sm font-semibold text-white no-underline transition hover:-translate-y-0.5 hover:bg-[#0077ed] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#8bb9ff] motion-reduce:transition-none" href="/editor/">
          {primaryCta}
        </a>
        <a class="inline-flex min-h-12 items-center justify-center rounded-full border border-[#d2d2d7] bg-white px-6 text-sm font-semibold text-[#1d1d1f] no-underline hover:border-[#86868b] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#8bb9ff]" href="#how-it-works">
          See how it works
        </a>
      </div>
      <ul class="mx-auto mt-7 flex max-w-3xl list-none flex-wrap justify-center gap-x-6 gap-y-2 p-0 text-sm font-medium text-[#6e6e73]">
        {facts.map((fact) => <li class="before:mr-2 before:text-[#0071e3] before:content-['✓']">{fact}</li>)}
      </ul>
      {showHeroExportFormats && <ExportFormatRow class="mx-auto mt-8" eager />}
      <a class="group relative mx-auto mt-14 block max-w-[68rem] overflow-hidden rounded-t-xl border border-b-0 border-[#d2d2d7] bg-white focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-[#8bb9ff]" href="/editor/" aria-label={`Open ${SITE_NAME} editor`}>
        <picture class="block">
          <source media="(max-width: 640px)" srcset={heroImage.mobileSrc} type="image/webp" />
          <img class="aspect-[16/10] w-full object-cover object-top max-sm:aspect-[13/14]" src={heroImage.desktopSrc} alt={heroImage.alt} width="1440" height="900" loading="eager" fetchpriority="high" />
        </picture>
      </a>
    </div>
  </section>

  <section id="how-it-works" class="scroll-mt-8 bg-white px-4 py-20 font-inter text-[#1d1d1f] sm:px-8 sm:py-28">
    <div class="mx-auto max-w-[68rem]">
      {sections.map((section) => (
        <article class="py-12 md:py-16">
          <div class="mx-auto max-w-4xl">
            <h2 class="text-2xl font-semibold tracking-[-0.03em] sm:text-3xl lg:text-4xl">{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p class="mt-5 text-base leading-7 text-[#515154] sm:text-lg sm:leading-8">{paragraph}</p>)}
            {section.highlights && <FeatureIconGrid label={`${section.title} features`} items={section.highlights} />}
            {section.points && (
              <ul class="mt-6 grid list-none gap-3 p-0 sm:grid-cols-2">
                {section.points.map((point) => <li class="rounded-xl bg-[#f5f5f7] px-4 py-3 text-sm font-medium text-[#3a3a3c]">{point}</li>)}
              </ul>
            )}
            {section.showExportFormats && <ExportFormatRow class="mt-8" />}
            {section.image && (
              <figure class="mt-10">
                <div class="overflow-hidden rounded-xl border border-[#d2d2d7] bg-white">
                  <img
                    class="h-auto w-full"
                    src={section.image.src}
                    alt={section.image.alt}
                    width={section.image.width}
                    height={section.image.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption class="mt-3 text-left">
                  <strong class="block text-sm font-semibold text-[#1d1d1f]">{section.image.title}</strong>
                  <span class="mt-1 block text-xs leading-5 text-[#6e6e73]">{section.image.caption}</span>
                </figcaption>
              </figure>
            )}
            {section.imageRow && (
              <div class="-mx-4 mt-10 grid snap-x snap-mandatory auto-cols-[78%] grid-flow-col gap-3 overflow-x-auto overscroll-x-contain px-4 pb-2 sm:mx-0 sm:grid-flow-row sm:grid-cols-3 sm:overflow-visible sm:px-0 sm:pb-0">
                {section.imageRow.map((image) => (
                  <figure class="min-w-0 snap-start">
                    <div class="overflow-hidden rounded-xl border border-[#d2d2d7] bg-white">
                      <img
                        class="h-auto w-full"
                        src={image.src}
                        alt={image.alt}
                        width={image.width}
                        height={image.height}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <figcaption class="mt-3 text-left">
                      <strong class="block text-sm font-semibold text-[#1d1d1f]">{image.title}</strong>
                      <span class="mt-1 block text-xs leading-5 text-[#6e6e73]">{image.caption}</span>
                    </figcaption>
                  </figure>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-[#0071e3] px-4 py-20 font-inter text-white before:pointer-events-none before:absolute before:inset-0 before:z-0 before:bg-[url('/noise.svg')] before:opacity-50 before:content-[''] sm:px-8 sm:py-24">
    <div class="relative z-10 mx-auto max-w-[68rem] text-center">
      <p class="text-sm font-semibold tracking-[0.08em] text-white/70 uppercase">Ready to start?</p>
      <h2 class="mx-auto mt-4 max-w-3xl text-3xl font-semibold tracking-[-0.035em] sm:text-4xl lg:text-5xl">Open the editor and make a map for your next project.</h2>
      <a class="mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-white px-6 text-sm font-semibold text-[#0071e3] no-underline transition hover:-translate-y-0.5 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-white motion-reduce:transition-none" href="/editor/">
        {primaryCta}
      </a>
    </div>
  </section>

  <section class="bg-white px-4 py-20 font-inter text-[#1d1d1f] sm:px-8 sm:py-24" aria-labelledby="related-pages-title">
    <div class="mx-auto max-w-[68rem]">
      <h2 id="related-pages-title" class="text-2xl font-semibold tracking-[-0.03em] sm:text-3xl lg:text-4xl">More ways to use Print Map Studio.</h2>
      <div class="mt-10 grid gap-3 md:grid-cols-2">
        {relatedLinks.map((link) => (
          <a class="group rounded-xl bg-[#f5f5f7] px-6 py-5 no-underline focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#8bb9ff]" href={link.href}>
            <h3 class="text-xl font-semibold tracking-[-0.02em] group-hover:text-[#0071e3]">{link.label}</h3>
            <p class="mt-2 text-sm leading-6 text-[#6e6e73]">{link.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <SimpleFaqSection
    id="questions"
    title="Common questions."
    description="Details about file formats, storage, and exports."
    items={faq}
  />
</MarketingLayout>
