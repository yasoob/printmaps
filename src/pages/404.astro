---
import MarketingLayout from '../marketing/MarketingLayout.astro';
import { navigationGroups, pagePath } from '../marketing/registry';

const groups = navigationGroups().filter((group) => group.id !== 'project');
---

<MarketingLayout
  title="Page not found"
  description="This page does not exist. Open the Print Map Studio editor or pick one of the guides and feature pages to continue making your map."
  robots="noindex"
>
  <section class="bg-[#f5f5f7] px-4 py-24 font-inter text-[#1d1d1f] sm:px-8 sm:py-32">
    <div class="mx-auto max-w-[68rem]">
      <span class="text-[0.72rem] font-semibold tracking-[0.1em] text-[#6e6e73] uppercase">404</span>
      <h1 class="mt-4 max-w-3xl text-4xl leading-[0.95] font-semibold tracking-[-0.045em] sm:text-5xl lg:text-6xl">This page isn't on the map.</h1>
      <p class="mt-7 max-w-2xl text-base leading-7 text-[#6e6e73] sm:text-lg sm:leading-8">
        The link may be old or mistyped. Shared maps open in the editor, so if someone sent you a map, check that the whole link was copied.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#0071e3] px-6 text-sm font-semibold text-white no-underline hover:bg-[#0077ed] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#8bb9ff]" href="/editor/">Open the editor</a>
        <a class="inline-flex min-h-12 items-center justify-center rounded-full border border-[#d2d2d7] bg-white px-6 text-sm font-semibold text-[#1d1d1f] no-underline hover:border-[#86868b] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#8bb9ff]" href="/">Go to the homepage</a>
      </div>
      <div class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {groups.map((group) => (
          <div>
            <h2 class="text-sm font-semibold tracking-[0.06em] text-[#86868b] uppercase">{group.label}</h2>
            <ul class="mt-3 list-none space-y-2 p-0">
              {group.pages.map((entry) => (
                <li><a class="text-base font-medium text-[#1d1d1f] no-underline hover:text-[#0071e3]" href={pagePath(entry)}>{entry.navLabel}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</MarketingLayout>
