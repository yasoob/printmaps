---
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

const canonicalUrl = new URL('/editor/', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="Design a custom print-ready map with routes, places, areas and high-resolution export." />
    <meta name="robots" content="noindex,follow" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Map editor | Print Map Studio</title>
    <GoogleAnalytics />
  </head>
  <body>
    <div id="root"></div>
    <noscript>
      <main>
        <h1>JavaScript is required to use Print Map Studio.</h1>
        <p>The map editor runs locally in your browser.</p>
        <a href="/">Return to the Print Map Studio homepage</a>
      </main>
    </noscript>
    <script>
      import '../main';
    </script>
  </body>
</html>
