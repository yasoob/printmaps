---
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { SITE_NAME } from '../marketing/product';
import { ogImageFor } from '../marketing/registry';

const canonicalUrl = new URL('/editor/', Astro.site);
const title = 'Map editor | Print Map Studio';
const description = 'Design a custom print-ready map with routes, places, areas and high-resolution export.';
const ogImage = ogImageFor('');
const ogImageUrl = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{title}</title>
    <GoogleAnalytics skipSharedMaps />
  </head>
  <body>
    <div id="root"></div>
    <noscript>
      <main>
        <h1>JavaScript is required to use Print Map Studio.</h1>
        <p>The map editor runs locally in your browser.</p>
        <a href="/">Return to the Print Map Studio homepage</a>
      </main>
    </noscript>
    <script>
      import '../main';
    </script>
  </body>
</html>
