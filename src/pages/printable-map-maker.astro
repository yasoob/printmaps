---
import { media } from '../marketing/media';
import { page } from '../marketing/pages/printable-map-maker';
import SeoLandingPage, { type PageSection } from '../marketing/SeoLandingPage.astro';

const sections: readonly PageSection[] = [
  {
    title: 'Set the page size before you design',
    paragraphs: [
      'Choose A2, A3, A4, A5, A6 or US Letter, switch between portrait and landscape, or type a custom width and height in millimetres. The editor draws a print frame at that size, so you compose against the real page instead of a browser window.',
      'For a map that goes inside a document, size the page to the space it will fill. A4 with 25 mm margins leaves a 160 mm text column, and US Letter with one-inch margins leaves 165 mm. A 160 × 110 mm custom page drops into either without scaling. The [map print size guide](/map-print-size-guide/) lists the pixel dimensions for every common size.',
    ],
    highlights: [
      { icon: 'a-series', label: 'A2–A6 presets' },
      { icon: 'us-letter', label: 'US Letter' },
      { icon: 'orientation', label: 'Portrait or landscape' },
      { icon: 'dimensions', label: 'Custom millimetres' },
    ],
    image: {
      src: '/explore-shots/printable-page-frame.webp',
      alt: 'Visible A4 landscape print frame over a styled Copenhagen map in Print Map Studio',
      width: 915,
      height: 715,
      title: 'Keep the print boundary visible.',
      caption: 'The frame shows which map details and overlays will fit on the selected page.',
    },
  },
  {
    kind: 'table',
    id: 'document-maps',
    title: 'Maps for handouts, reports and guidebooks',
    paragraphs: [
      'Most printed maps are not posters. They sit on a handout, in a report appendix or on a guidebook page, next to text that explains them. These are good starting points for the jobs that come up most.',
    ],
    headers: ['Document', 'Page to set', 'What to add', 'File to export'],
    rows: [
      ['Event handout', 'A4 or US Letter portrait', 'The venue and parking as places, a walking route from the station, a scale bar', 'PDF for the copy shop'],
      ['Report figure', '160 × 110 mm custom page, margins 0', 'Site boundary as a shape, a coordinate grid with labels, a north compass', 'PNG for Word, PDF for InDesign'],
      ['Guidebook page', 'A5 or A6 portrait', 'A day walk with its stops, labels at 120–130% text scale', 'PDF or layered SVG for the designer'],
      ['Brochure panel', 'Custom 99 × 210 mm for a DL panel', 'Two or three places with your own marker, quiet base map', 'PDF'],
      ['Field sheet', 'A4 landscape', 'Coordinate grid at a round interval, metric scale bar, contour lines', 'PDF'],
    ],
    caption: 'Suggested page sizes and exports for common print documents.',
  },
  {
    title: 'Make the map readable on paper',
    paragraphs: [
      'Print Map Studio has 12 styles, from Paper and Porcelain to Graphite, Night Ink, Blueprint and Alpine. Each sets the colours for land, water, roads, parks, buildings, boundaries, transit and labels, and the palette editor lets you shift tone, contrast and detail or replace any of them.',
      'Labels come in local names plus 6 languages: English, German, French, Italian, Spanish and Chinese. Text scales from 50% to 200%. Street names that look fine on screen often print too small on an A5 page, so a text scale of 120–130% is a sensible start for handouts.',
      'If the document will be photocopied in black and white, pick Graphite or Porcelain and give each route a dashed or solid line, so they stay distinct without colour.',
    ],
    highlights: [
      { icon: 'palette', label: '12 map styles' },
      { icon: 'language', label: 'Local names plus 6 languages' },
      { icon: 'text-scale', label: '50–200% text scale' },
      { icon: 'visibility', label: '7 detail toggles' },
    ],
    imageRow: [
      {
        src: '/explore-shots/custom-colors.webp',
        alt: 'Print Map Studio custom palette with tone, contrast, detail and colour controls',
        width: 1130,
        height: 1716,
        title: 'Customise the palette',
        caption: 'Adjust tone, contrast, detail and individual map colours.',
      },
      {
        src: '/explore-shots/map-features.webp',
        alt: 'Print Map Studio map detail controls with roads, buildings and transit turned off',
        width: 1130,
        height: 1716,
        title: 'Toggle map details',
        caption: 'Show or hide roads, buildings, labels, water, parks, land detail and transit.',
      },
      {
        src: '/explore-shots/labels-and-text.webp',
        alt: 'Print Map Studio language selector and text scale controls set to German',
        width: 1130,
        height: 1716,
        title: 'Change labels and text size',
        caption: 'Choose a label language, then scale the map text from 50% to 200%.',
      },
    ],
  },
  {
    title: 'Add routes, places and boundaries',
    paragraphs: [
      'Draw routes as straight lines, arcs or road-following directions, drop single places, or paste up to 300 rows of coordinates into the place spreadsheet. Shade countries and first-level regions from the boundary catalogue, draw your own shapes, or add [travel-time areas](/travel-time-map/) for 5 to 60 minutes by car, bike or on foot.',
      'Recorded tracks come in through the [GPX map maker](/gpx-map-maker/) as editable layers. Every route, place and shape can be styled, reordered, hidden or duplicated, and places can use your own PNG, JPEG or SVG marker, such as a company logo.',
    ],
    highlights: [
      { icon: 'route', label: 'Routes and waypoints' },
      { icon: 'marker', label: 'Places and markers' },
      { icon: 'region', label: 'Countries and regions' },
      { icon: 'import', label: 'GPX, KML, GeoJSON' },
    ],
  },
  {
    title: 'Add a scale bar, grid and compass',
    paragraphs: [
      'Reference maps need the small cartographic details that posters leave out. Add a metric or imperial scale bar from 10 to 100 mm wide, a coordinate grid at any interval from 0.01° to 90° with labelled lines, and a north compass as an arrow or a rose. Each sits in the corner you choose and is sized in millimetres, so it prints exactly as large as you set it.',
      'Pick a round grid interval that suits the area: 0.01° on a town plan, 0.1° on a regional map. For a printed map people will use to find a venue, a [location QR code](/share-and-embed-maps/) that opens Google Maps does more than a grid.',
    ],
    highlights: [
      { icon: 'scale-bar', label: 'Metric or imperial scale' },
      { icon: 'grid', label: 'Labelled coordinate grid' },
      { icon: 'compass', label: 'Arrow or rose compass' },
      { icon: 'qr-code', label: 'Location QR code' },
    ],
  },
  {
    title: 'Place the map in Word, InDesign or a print shop file',
    paragraphs: [
      'PDF keeps the exact page size, with routes, places, shapes, the grid and the scale bar as vectors over a 300 DPI basemap. It places cleanly in InDesign, Affinity Publisher and Illustrator, and most print shops accept it as it is.',
      'PNG is a 300 DPI image with its DPI written into the file, so Word and InDesign place a 160 mm map at 160 mm. Layered SVG and layered PSD keep each layer separate for a designer to finish. The [layered export page](/layered-map-export/) compares all four formats.',
      'Every export carries a small credit for OpenStreetMap, OpenMapTiles and OpenFreeMap in the bottom margin, or in a slim strip under the map when the margins are zero. Files are made in your browser and download straight away, with no watermark.',
    ],
    showExportFormats: true,
  },
];

const faq = [
  { question: 'What page sizes can I use?', answer: 'Choose A2, A3, A4, A5, A6 or US Letter, or enter a custom width and height in millimetres. Portrait and landscape both work, and custom pages go up to 1330 mm a side.' },
  { question: 'How do I put a map into a Word document?', answer: 'Set a custom page the width of your text column, for example 160 × 110 mm, set the margins to 0 and export a PNG. Word reads the DPI stored in the file and inserts the map at 160 mm wide.' },
  { question: 'Will the map print sharply on an office printer?', answer: 'Yes. PNG and PDF exports are rendered at 300 DPI for the page you set, and in PDF the routes, places, scale bar and grid stay as vector lines.' },
  { question: 'Can I add a scale bar and a grid?', answer: 'Yes. The Layout tab has a metric or imperial scale bar, a coordinate grid with optional labels, a north compass and a location QR code.' },
  { question: 'Which export format should I choose?', answer: 'PDF for a print shop or InDesign, PNG for Word and slide decks, layered SVG for Illustrator or Inkscape, and layered PSD for Photoshop.' },
  { question: 'Where is my project saved?', answer: 'The project autosaves in your browser storage. Download a portable project file to keep a copy you can open on any computer.' },
] as const;
---

<SeoLandingPage
  page={page}
  eyebrow="Maps for print documents"
  heading="A printable map maker for handouts, reports and guidebooks"
  heroImage={media['editor.map-tab']}
  lead="Set an exact page size, style the map so it reads on paper, add routes, places, a scale bar and a grid, then export a 300 DPI PDF or PNG that drops straight into your document. It runs in your browser with no account and no watermark."
  primaryCta="Open the map editor"
  facts={['A4, US Letter and custom sizes', 'Scale bar and grid', 'Vector PDF', 'No account']}
  sections={sections}
  ctaHeading="Set an A4 page and make the map for your handout."
  faq={faq}
  faqDescription="Page sizes, Word and InDesign, scale bars and print quality."
/>
