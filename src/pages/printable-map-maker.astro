---
import { media } from '../marketing/media';
import { page } from '../marketing/pages/printable-map-maker';
import SeoLandingPage, { type PageSection } from '../marketing/SeoLandingPage.astro';

const sections: readonly PageSection[] = [
  {
    title: 'Set the page size before you design',
    paragraphs: [
      'Choose A2, A3, A4, A5, A6 or US Letter, switch between portrait and landscape, or type a custom width and height in millimetres. The editor draws a print frame at that size, so you compose against the real page instead of a browser window.',
      'Decide on the size first. A street map that looks balanced on A4 fills an A2 sheet with four times the area, and you will usually want to zoom in a step or turn some detail off. The map size guide lists the pixel dimensions for every common size if a print shop asks.',
    ],
    highlights: [
      { icon: 'a-series', label: 'A2-A6 presets' },
      { icon: 'us-letter', label: 'US Letter' },
      { icon: 'orientation', label: 'Portrait or landscape' },
      { icon: 'dimensions', label: 'Custom millimetres' },
    ],
    image: {
      src: '/explore-shots/printable-page-frame.webp',
      alt: 'Visible A4 landscape print frame over a styled Vienna map in Print Map Studio',
      width: 915,
      height: 715,
      title: 'Keep the print boundary visible.',
      caption: 'The frame shows which map details and overlays will fit on the selected page.',
    },
  },
  {
    title: 'Pick a style and control the labels',
    paragraphs: [
      'Print Map Studio has 12 styles, from Paper and Sandstone to Night Ink, Blueprint, Alpine and Coastal. Each one sets the colours for land, water, roads, parks, buildings, boundaries, transit and labels. Shift the palette warmer or cooler, adjust contrast and detail, or replace any of those colours with your own.',
      'Show labels in the local language, English, German, French, Italian, Spanish or Chinese, and scale the text from 50% to 200%. Turning off buildings and transit is the quickest way to make a busy city calm enough for your own routes and places.',
    ],
    highlights: [
      { icon: 'palette', label: '12 map styles' },
      { icon: 'language', label: '7 label languages' },
      { icon: 'text-scale', label: '50-200% text scale' },
      { icon: 'visibility', label: '7 detail toggles' },
    ],
    imageRow: [
      {
        src: '/explore-shots/custom-colors.webp',
        alt: 'Print Map Studio custom palette with tone contrast detail and color controls',
        width: 1130,
        height: 1716,
        title: 'Customize the palette',
        caption: 'Adjust tone, contrast, detail and individual map colours.',
      },
      {
        src: '/explore-shots/map-features.webp',
        alt: 'Print Map Studio map detail controls with roads buildings and transit turned off',
        width: 1130,
        height: 1716,
        title: 'Toggle map details',
        caption: 'Show or hide roads, buildings, labels, water, parks, land use and transit.',
      },
      {
        src: '/explore-shots/labels-and-text.webp',
        alt: 'Print Map Studio language selector and text scale controls set to German',
        width: 1130,
        height: 1716,
        title: 'Change labels and text size',
        caption: 'Choose a label language, then scale the map text from 50% to 200%.',
      },
    ],
  },
  {
    title: 'Lay out the poster around the map',
    paragraphs: [
      'The Layout tab turns the map into a finished page. Start from one of five layout presets (City edition, Quiet lines, After dark, Land & outline or Field notes), then edit the title, subtitle, caption and coordinates. Pick a modern sans, a classic serif or a field-notes mono typeface and set the text anywhere from 6 to 120 pt.',
      'Margins default to 10 mm and can be set per side. Change the paper colour for a dark poster, or switch the map frame from a rectangle to the outline of a country or region, so Portugal or Hokkaido becomes the shape of the map itself.',
    ],
    highlights: [
      { icon: 'template', label: '5 layout presets' },
      { icon: 'title', label: 'Title and caption' },
      { icon: 'layout', label: 'Margins and paper colour' },
      { icon: 'country-shape', label: 'Country-shaped frame' },
    ],
    image: {
      ...media['editor.layout-tab'],
      title: 'Layout presets, text and margins in one tab.',
      caption: 'Change the design without touching the map, routes or places underneath.',
    },
    imagePosition: 'beside',
  },
  {
    title: 'Add routes, places, and boundaries',
    paragraphs: [
      'Draw routes as straight lines, arcs or road-following directions, drop single places, or paste up to 300 rows of coordinates into the place spreadsheet. Shade countries and first-level regions from the boundary catalogue, draw your own shapes, or add travel-time areas for 5 to 60 minutes by car, bike or on foot.',
      'GPX, KML and GeoJSON files become editable layers. Every route, place and shape can be styled, reordered, hidden or duplicated, and places can use your own PNG, JPEG or SVG marker.',
    ],
    highlights: [
      { icon: 'route', label: 'Routes and waypoints' },
      { icon: 'marker', label: 'Places and markers' },
      { icon: 'region', label: 'Countries and regions' },
      { icon: 'import', label: 'GPX, KML, GeoJSON' },
    ],
  },
  {
    title: 'Finish with a compass, scale bar or QR code',
    paragraphs: [
      'Small cartographic details make a printed map easier to use. Add a north compass as an arrow or a rose, a metric or imperial scale bar, a coordinate grid with labelled lines, or a QR code that opens the location in Google Maps. Each one goes in the corner you pick and is sized in millimetres, so it prints at a predictable size.',
      'A scale bar is most useful on hiking and site maps where people estimate distance. On a city poster, a 30 mm compass in the lower corner usually reads better than a grid.',
    ],
    highlights: [
      { icon: 'compass', label: 'North compass' },
      { icon: 'scale-bar', label: 'Scale bar' },
      { icon: 'grid', label: 'Coordinate grid' },
      { icon: 'qr-code', label: 'Location QR code' },
    ],
  },
  {
    title: 'Preview the print on a wall',
    paragraphs: [
      'Before you order a print, open the wall preview. It places your poster in an unframed, black, white, oak or walnut frame, with a mat up to 50 mm wide and the wall colour of your choice. It is a quick way to check whether a dark style feels heavy in a bright room, or whether the title is big enough from across the sofa.',
    ],
    image: {
      ...media['editor.wall-preview'],
      title: 'See the poster framed before you print it.',
      caption: 'Frame finish, mat and wall colour are for the preview and stay out of your export.',
    },
  },
  {
    title: 'Choose PNG, PDF, SVG, or PSD',
    paragraphs: [
      'PNG gives a flat 300 DPI image at the physical page size. PDF keeps the exact page dimensions with routes, places, shapes and poster text as vectors over a 300 DPI basemap. Layered SVG keeps content in named vector groups, and layered PSD puts each content layer in its own Smart Object for Photoshop.',
      'Every format carries a small map data credit for OpenStreetMap, OpenMapTiles and OpenFreeMap in the bottom margin. Files are made in your browser and download straight away, with no watermark.',
    ],
    showExportFormats: true,
  },
];

const faq = [
  { question: 'What page sizes can I use?', answer: 'Choose A2, A3, A4, A5, A6 or US Letter, or enter a custom width and height in millimetres. Portrait and landscape both work, and custom pages go up to 1330 mm a side.' },
  { question: 'Do I need an account to export?', answer: 'No. The editor and every export format work without signing up.' },
  { question: 'Can I add a title and text to the map?', answer: 'Yes. The Layout tab has a title, subtitle, caption and coordinates line, five layout presets, three typefaces and per-side margins.' },
  { question: 'Where is my project saved?', answer: 'The project autosaves in your browser storage. Download a portable project file as a backup or to move the map to another computer.' },
  { question: 'How do I get a printed copy?', answer: 'Download a PDF or PNG and send it to any print shop or online printer. The map print size guide explains which file to send and how to handle margins and bleed.' },
  { question: 'Which export format should I choose?', answer: 'PNG for a flat image, PDF for an exact page with vector overlays, layered SVG for named vector groups, or layered PSD for separate Smart Object layers in Photoshop.' },
] as const;
---

<SeoLandingPage
  page={page}
  eyebrow="Free browser-based map editor"
  heading="Build a printable map at the exact page size."
  heroImage={media['editor.map-tab']}
  lead="Set the page size, choose a map style, add routes and places, and lay out the poster around them. Then export a print-ready PNG, PDF, layered SVG or PSD. The editor runs in your browser with no account and no watermark."
  primaryCta="Open the map editor"
  facts={['Free to use', 'No account', 'Custom page sizes', 'Four print formats']}
  sections={sections}
  faq={faq}
/>
