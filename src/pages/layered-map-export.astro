---
import { page } from '../marketing/pages/layered-map-export';
import SeoLandingPage, { type PageSection } from '../marketing/SeoLandingPage.astro';

const sections: readonly PageSection[] = [
  {
    title: 'PNG for a finished image',
    paragraphs: [
      'PNG downloads the complete map as one 300 DPI image at the page size you chose. The DPI is written into the file, so InDesign, Word or a print shop RIP opens an A3 export as a 420 × 297 mm image without any resizing.',
      'Choose PNG when you want a file that is easy to place and share. A single PNG goes up to 50 × 70 cm, and A1 or 24 × 36 in posters stream straight to disk in Chrome and Edge. There is no watermark.',
    ],
    highlights: [
      { icon: 'pixels', label: 'High-resolution image' },
      { icon: 'dimensions', label: 'Selected page size' },
      { icon: 'share', label: 'Easy to place and share' },
      { icon: 'layout', label: 'Ready for print layouts' },
    ],
    image: {
      src: '/explore-shots/export-flat-map.webp',
      alt: 'Print Map Studio map composition inside an A4 landscape print frame',
      width: 1400,
      height: 1040,
      title: 'Download the map inside the print frame.',
      caption: 'The PNG includes the map, routes, places, and shapes shown inside the selected page.',
    },
  },
  {
    title: 'PDF for exact-size printing',
    paragraphs: [
      'PDF keeps the physical page size you set in the editor. The basemap is rendered at 300 DPI, while routes, markers, shapes and poster text stay as vectors, so they print crisp at any size up to A1.',
      'Choose PDF for print shops, reports, brochures, or any layout that must keep exact dimensions. Most online printers accept it as is.',
    ],
    highlights: [
      { icon: 'us-letter', label: 'Exact page dimensions' },
      { icon: 'route', label: 'Sharp routes and markers' },
      { icon: 'pdf-reader', label: 'Opens in PDF readers' },
      { icon: 'print', label: 'Ready to print' },
    ],
    image: {
      src: '/explore-shots/export-pdf-summary.webp',
      alt: 'Print Map Studio PDF export summary with page size and download button',
      width: 1024,
      height: 852,
      title: 'Confirm the page size before downloading.',
      caption: 'The PDF summary shows the selected orientation and physical dimensions.',
    },
  },
  {
    title: 'Layered SVG for flexible editing',
    paragraphs: [
      'Layered SVG keeps routes, markers and shapes in named groups. Open the file in Illustrator, Inkscape or Affinity Designer to recolour, hide or move them.',
      'On a flat map you can also switch the basemap to vector artwork, with roads, water and labels as editable paths and text. That is the option to pick when a designer wants to restyle the map itself.',
    ],
    highlights: [
      { icon: 'layers', label: 'Named content groups' },
      { icon: 'color-edit', label: 'Edit route and marker colors' },
      { icon: 'transform', label: 'Hide or move content' },
      { icon: 'svg-editor', label: 'Works in SVG editors' },
    ],
  },
  {
    title: 'Layered PSD for Photoshop',
    paragraphs: [
      'Layered PSD opens as an organised Photoshop document. Routes, places, shapes and the map credit arrive as separately named Smart Objects over the basemap, so they are easy to find and adjust.',
      'PSD files are rendered at 300 DPI up to A4 and US Letter. On larger pages the exporter picks a resolution that keeps the layered file responsive in Photoshop and shows it before you download.',
    ],
    highlights: [
      { icon: 'psd-file', label: 'Photoshop-ready' },
      { icon: 'layer-labels', label: 'Named content layers' },
      { icon: 'smart-object', label: 'Smart Objects' },
      { icon: 'separate-elements', label: 'Separate map elements' },
    ],
    showPhotoshopHandoff: true,
  },
  {
    title: 'Export without uploading your project',
    paragraphs: [
      'Print Map Studio builds each file in your browser and downloads it directly, with no account and no queue. Your map, photos and imported tracks stay on your device.',
      'Download the project file too, as a .printmap.json or .printmap.zip, if you want to come back and change the map later.',
    ],
    highlights: [
      { icon: 'browser', label: 'Stays in your browser' },
      { icon: 'download', label: 'Direct download' },
      { icon: 'no-account', label: 'No account' },
      { icon: 'save', label: 'Save for later' },
    ],
    image: {
      src: '/explore-shots/export-project-download.webp',
      alt: 'Print Map Studio Project menu with Download project action',
      width: 860,
      height: 780,
      title: 'Save the project for later edits.',
      caption: 'Use the Project menu to download a copy that you can open again.',
    },
  },
  {
    title: 'Video and 3D model exports',
    paragraphs: [
      'The Export dialog has two more tabs next to Print. Video records the poster as an MP4 with an orbit or sway camera move, 5, 10 or 15 seconds long at 30 or 60 fps, in the page shape or in 16:9, 9:16, 1:1 or 4:5 for social posts. It records in Chrome, Edge and Safari.',
      '3D model turns the terrain inside the print area into an STL file for a 3D printer, sized in millimetres, with an optional raised ridge along your route.',
    ],
    highlights: [
      { icon: 'video', label: 'MP4 map video' },
      { icon: 'relief-3d', label: 'STL terrain model' },
      { icon: 'terrain', label: 'Route ridge option' },
      { icon: 'download', label: 'Direct download' },
    ],
  },
];
const faq = [
  { question: 'Which export format should I choose?', answer: 'Choose PNG for a finished image, PDF for exact-size printing, SVG for editing in a vector design tool, or PSD for an organized Photoshop file.' },
  { question: 'Can I edit the map after exporting?', answer: 'Yes. Choose layered SVG or layered PSD when you want routes, places, and shapes kept in separate named groups or Smart Objects.' },
  { question: 'Does PDF keep the page size I selected?', answer: 'Yes. PDF preserves the physical page dimensions set in the editor, including standard and custom page sizes.' },
  { question: 'Which apps open each format?', answer: 'PNG opens in any image or layout tool, PDF in any PDF reader, layered SVG in Illustrator, Inkscape or Affinity Designer, and layered PSD in Photoshop.' },
  { question: 'Where are export files made?', answer: 'In your browser. Each file is generated on your device and saved straight to your downloads folder.' },
  { question: 'Is the map data credit included?', answer: 'Yes. Every export prints a small credit for OpenStreetMap, OpenMapTiles and OpenFreeMap in the bottom margin, which covers the attribution the map data licence asks for.' },
] as const;
---

<SeoLandingPage
  page={page}
  eyebrow="PNG, PDF, SVG, and PSD"
  heading="Download the map in the format you need."
  heroImage={{
    desktopSrc: '/explore-shots/psd-workflow-editor.webp',
    desktopAspect: '2000:1155',
    desktopWidth: 2000,
    desktopHeight: 1155,
    mobileSrc: '/explore-shots/export-editor-overview-mobile.webp',
    alt: 'Print Map Studio editor showing named layers, a route, places, and a walking area',
  }}
  lead="Download a 300 DPI PNG, an exact-size PDF, an editable SVG or a layered PSD. Every export is made in your browser with no account or watermark, and the same project can also become a map video or a 3D model."
  primaryCta="Create an export"
  facts={['High-resolution exports', 'No account', 'No watermark']}
  showHeroExportFormats
  sections={sections}
  faq={faq}
/>
