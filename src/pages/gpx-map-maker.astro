---
import { media } from '../marketing/media';
import { page } from '../marketing/pages/gpx-map-maker';
import SeoLandingPage, { type PageSection } from '../marketing/SeoLandingPage.astro';

const sections: readonly PageSection[] = [
  {
    title: 'Import a recorded track',
    paragraphs: [
      'Upload a GPX file from a hike, ride, run or road trip. Most GPS watches and route-planning apps can export one from the activity page. KML and GeoJSON work the same way, whether the data came from Google Earth, another map tool or an open data portal.',
      'Drop up to 10 files at once. The importer checks each file, then adds its tracks, routes, waypoints and shapes to the project as separate layers. A single GPX, KML or GeoJSON file can be up to 5 MB with 1,000 features and 200,000 coordinate points, which covers a multi-day hike recorded every second.',
    ],
    highlights: [
      { icon: 'gpx', label: 'GPX 1.0 and 1.1' },
      { icon: 'kml', label: 'KML files' },
      { icon: 'geojson', label: 'GeoJSON files' },
      { icon: 'validation', label: 'File validation' },
    ],
    image: {
      src: '/explore-shots/imported-layers-overview.webp',
      alt: 'Route waypoint and shape listed as separate layers beside the Print Map Studio map',
      width: 1840,
      height: 1300,
      title: 'Imported data becomes map layers.',
      caption: 'Routes, waypoints, and shapes stay separate so you can style, reorder, or hide them.',
    },
  },
  {
    title: 'Style the route and its context',
    paragraphs: [
      'Tracks and waypoints become separate editable layers. Change the route line, style waypoint markers, reorder layers, or hide anything you do not need.',
      'Contrast matters more than colour. A red track blends into the warm brick tones of Terracotta and stands out clearly on the cool greys of Graphite, so pick the style with the route in view. Then thin out labels, buildings or transit if the base map is still too busy.',
      'Route controls cover colour, width, line pattern, outline and opacity, plus a travel marker for air, train, car, walking, cycling or ship. Give each day of a trip its own colour, or keep one route bold over a detailed street map.',
    ],
    highlights: [
      { icon: 'route', label: 'Editable route lines' },
      { icon: 'marker', label: 'Waypoint styling' },
      { icon: 'layers', label: 'Layer order and visibility' },
      { icon: 'palette', label: '12 map styles' },
    ],
    imageRow: [
      {
        src: '/explore-shots/route-appearance.webp',
        alt: 'Print Map Studio route line color width and travel marker controls',
        width: 1130,
        height: 1716,
        title: 'Style the route line',
        caption: 'Set the colour, width, line pattern, travel marker, visibility and opacity.',
      },
      {
        src: '/explore-shots/route-advanced.webp',
        alt: 'Print Map Studio advanced route structure and editing controls',
        width: 1130,
        height: 1716,
        title: 'Open advanced route tools',
        caption: 'Convert, reverse, close, match, edit vertices, or generate an elevation profile.',
      },
      {
        src: '/explore-shots/waypoint-style.webp',
        alt: 'Print Map Studio waypoint color size shape symbol and label controls',
        width: 1130,
        height: 1716,
        title: 'Style each waypoint',
        caption: 'Change the marker colour, size, shape, symbol, label or coordinates.',
      },
    ],
  },
  {
    title: 'Snap a wobbly track to the roads',
    paragraphs: [
      'GPS recordings drift, especially between tall buildings. Road matching in the advanced route tools fits a recorded trace to the road network, so a city bike ride follows the streets instead of cutting across blocks.',
      'The same panel can reverse a route, close a loop, convert between line types and edit individual points when one stray reading spoils the shape.',
    ],
    highlights: [
      { icon: 'route', label: 'Road matching' },
      { icon: 'transform', label: 'Reverse or close' },
      { icon: 'fit', label: 'Edit single points' },
      { icon: 'layers', label: 'Convert line types' },
    ],
  },
  {
    kind: 'steps',
    id: 'elevation-profile',
    title: 'Make an elevation profile for the route',
    paragraphs: [
      'An elevation profile shows the climbs at a glance, which is what most hikers and riders look for first. Print Map Studio builds one from Copernicus elevation data via Open-Meteo.',
    ],
    steps: [
      { title: 'Generate the profile', body: 'Select the route, open the advanced route tools and generate an elevation profile.' },
      { title: 'Size it for the page', body: 'Set a print width from 50 to 300 mm, choose metric or imperial units, and pick colours, a fill or gradient, grid lines and a font.' },
      { title: 'Read the numbers', body: 'The panel shows total ascent and descent, plus distance-based walking and cycling time estimates.' },
      { title: 'Download and place it', body: 'Save the profile as SVG, PNG or PDF and place it under the map in your layout, guidebook page or race flyer.' },
    ],
  },
  {
    title: 'Set the print area and page size',
    paragraphs: [
      'Fit the map around the full track or focus on one section. Use a standard page preset from A2 through A6 or US Letter, choose portrait or landscape, or enter custom dimensions in millimetres.',
      'The project autosaves in browser storage. Download a project file if you want a backup, because clearing browser data removes the local autosave.',
    ],
    highlights: [
      { icon: 'fit', label: 'Fit the full route' },
      { icon: 'orientation', label: 'Portrait or landscape' },
      { icon: 'dimensions', label: 'Custom millimetres' },
      { icon: 'save', label: 'Local autosave' },
    ],
    image: {
      src: '/explore-shots/gpx-print-frame.webp',
      alt: 'Alpine route positioned inside an A3 portrait print frame in Print Map Studio',
      width: 913,
      height: 715,
      title: 'Fit the route inside the print frame.',
      caption: 'Adjust the map until the full track and surrounding context fit the selected page.',
    },
  },
  {
    title: 'Export the route as raster or vector content',
    paragraphs: [
      'Use PNG for a flat 300 DPI image, or PDF for an exact physical page where routes and waypoints stay sharp as vector lines. Layered SVG keeps content as named vector groups for Illustrator or Inkscape.',
      'Layered PSD puts each route, waypoint and shape in its own Smart Object in Photoshop. The browser generates and downloads every format directly.',
    ],
    showExportFormats: true,
  },
];
const faq = [
  { question: 'Which GPS file formats can I import?', answer: 'GPX (versions 1.0 and 1.1), KML and GeoJSON. You can drop up to 10 files at once.' },
  { question: 'How large can a GPX or KML file be?', answer: 'Each file can be up to 5 MB, with up to 1,000 features and 200,000 coordinates.' },
  { question: 'What happens to waypoints?', answer: 'Waypoints are imported as place content that can be styled and managed separately from route layers.' },
  { question: 'Can I change the map after importing?', answer: 'Yes. Imported routes, places, and shapes become editable layers that can be styled, reordered, hidden, duplicated, or deleted.' },
  { question: 'Does the export keep my route as a vector?', answer: 'Yes. PDF, layered SVG and layered PSD keep routes and waypoints as vector content, so lines stay sharp at any print size.' },
  { question: 'Can I add an elevation profile?', answer: 'Yes. Generate one from the advanced route tools and download it as SVG, PNG or PDF, from 50 to 300 mm wide. Sampled route coordinates are sent to Open-Meteo to look up the elevations.' },
] as const;
---

<SeoLandingPage
  page={page}
  eyebrow="Import your recorded tracks"
  heading="Turn a GPX file into a print-ready map."
  heroImage={media['editor.layer-route']}
  lead="Upload a recorded route, style the track and waypoints, set the page size, and export the finished map. It all happens in your browser, with no GIS software or account to set up."
  primaryCta="Import your track"
  facts={['GPX, KML, and GeoJSON', 'Editable route layers', 'No account', 'Browser-based export']}
  sections={sections}
  faq={faq}
/>
