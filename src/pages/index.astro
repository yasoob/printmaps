---
import HomeCapabilities from '../marketing/HomeCapabilities.astro';
import HomeExplore from '../marketing/HomeExplore.astro';
import HomeFeatures from '../marketing/HomeFeatures.astro';
import HomeUseCases from '../marketing/HomeUseCases.astro';
import MapCapabilityStrip from '../marketing/MapCapabilityStrip.astro';
import MarketingHero from '../marketing/MarketingHero.astro';
import MarketingLayout from '../marketing/MarketingLayout.astro';
import { media } from '../marketing/media';
import { faqItems, SITE_URL } from '../marketing/product';
import { HOME_PAGE, ogImageFor } from '../marketing/registry';
import SimpleFaqSection from '../marketing/SimpleFaqSection.astro';
import {
  APPLICATION_ID,
  applicationNode,
  personNode,
  WEBSITE_ID,
  websiteNode,
} from '../marketing/structuredData';

const { title, description } = HOME_PAGE;
const ogImage = ogImageFor('');
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    personNode(),
    websiteNode(description),
    {
      '@type': 'WebPage',
      '@id': `${SITE_URL}/#webpage`,
      name: title,
      url: `${SITE_URL}/`,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': WEBSITE_ID },
      about: { '@id': APPLICATION_ID },
      primaryImageOfPage: { '@type': 'ImageObject', url: `${SITE_URL}${ogImage.src}`, width: ogImage.width, height: ogImage.height },
      dateModified: HOME_PAGE.updated,
    },
    applicationNode(description, media['hero.desktop']),
    {
      '@type': 'FAQPage',
      '@id': `${SITE_URL}/#faq`,
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<MarketingLayout
  title={title}
  description={description}
  includeSiteNameSuffix={false}
  ogImage={ogImage}
  showHeader={false}
  structuredData={structuredData}
>
  <MarketingHero />
  <MapCapabilityStrip />
  <HomeFeatures />
  <HomeCapabilities />
  <HomeUseCases />
  <HomeExplore />
  <SimpleFaqSection items={faqItems} />
</MarketingLayout>
