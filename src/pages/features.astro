---
import MarketingLayout from '../marketing/MarketingLayout.astro';
import { breadcrumbStructuredData, SITE_URL } from '../marketing/product';

const title = 'Printable map maker features';
const description = 'Explore Print Map Studio features for custom map design, routes, places, administrative areas, GPX/KML/GeoJSON import, local projects, and PNG, PDF, layered SVG or layered PSD export.';
const structuredData = breadcrumbStructuredData([
  { name: 'Home', url: `${SITE_URL}/` },
  { name: 'Features', url: `${SITE_URL}/features/` },
]);

const features = [
  {
    number: '01',
    title: 'Set the page and style the map',
    copy: 'Choose a standard or custom physical page size, switch orientation, position the map, and select a visual style. Fine-tune text scale, bearing, pitch, language, and the visibility of roads, buildings, labels, water, parks, land use, and transit.',
    tags: ['Print dimensions', 'Map styles', 'Text scale', 'Feature visibility'],
  },
  {
    number: '02',
    title: 'Draw routes your way',
    copy: 'Sketch a route directly on the map, create road-following directions when provider services are available, or build straight and curved route segments. Adjust the line, edit vertices, reposition the geometry, and add an elevation profile.',
    tags: ['Freehand routes', 'Road routing', 'Map matching', 'Elevation profiles'],
  },
  {
    number: '03',
    title: 'Place points with context',
    copy: 'Add a place by clicking the map, searching, or entering coordinates. Customize marker shape, color, icon, label, and position. Paste a spreadsheet of coordinates or addresses when a project needs many locations.',
    tags: ['Custom markers', 'Place search', 'Spreadsheet import', 'Labels'],
  },
  {
    number: '04',
    title: 'Highlight shapes and regions',
    copy: 'Draw editable shapes, add countries and first-level administrative regions from the global catalogue, or generate travel-time areas with a configured provider. Every area remains an independent, styleable layer.',
    tags: ['Countries', 'Regions', 'Custom shapes', 'Isochrones'],
  },
  {
    number: '05',
    title: 'Bring the geography you have',
    copy: 'Import GPX, KML, and GeoJSON files in the browser. Routes, points, and polygons are converted into project layers that can be selected, reordered, restyled, hidden, duplicated, or removed.',
    tags: ['GPX', 'KML', 'GeoJSON', 'Layer controls'],
  },
  {
    number: '06',
    title: 'Export for the next step',
    copy: 'Download a print-sized PNG, an exact-page PDF, a layered SVG, or a layered PSD. Supported routes, points, and shapes remain vector content in PDF and SVG; PSD embeds them as separate SVG Smart Objects.',
    tags: ['PNG', 'PDF', 'Layered SVG', 'Layered PSD'],
  },
] as const;
---

<MarketingLayout title={title} description={description} structuredData={structuredData}>
  <header class="page-hero">
    <div class="page-hero__grid">
      <div>
        <span class="eyebrow">Printable map maker features</span>
        <h1>Every tool earns its place.</h1>
      </div>
      <div class="page-hero__aside">
        <p>
          Design the base map, layer in your own story, and export a file built for its
          final size. The workflow stays visual from start to finish.
        </p>
        <a class="button button--ink" href="/editor/">Open the editor</a>
      </div>
    </div>
  </header>

  <section class="page-band">
    <div class="section section--compact">
      <div class="detail-list">
        {features.map((feature) => (
          <article class="detail-row">
            <span class="detail-row__number">{feature.number}</span>
            <h2>{feature.title}</h2>
            <div class="detail-row__copy">
              <p>{feature.copy}</p>
              <div class="tag-list" aria-label={`${feature.title} capabilities`}>
                {feature.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--wide">
    <div class="accuracy-note">
      <h2>Honest files. Clear expectations.</h2>
      <div class="accuracy-note__copy">
        <p>
          PNG is a raster image produced for the selected page size. PDF preserves the
          physical page and supported vector overlays. Layered SVG keeps named vector groups,
          while layered PSD embeds each content layer as a named SVG Smart Object.
        </p>
        <p>
          The basemap can still be raster inside PDF, SVG and PSD. Print Map Studio does not
          claim an all-vector basemap, CMYK output, PDF/X certification, or native
          Photoshop type and shape layers.
        </p>
        <a class="text-link" href="/#faq">
          Read export answers
          <span aria-hidden="true">-&gt;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="page-band page-band--blue">
    <div class="section section--compact">
      <div class="showcase">
        <div class="showcase__copy">
          <span class="eyebrow">Projects without an account</span>
          <h2>Start now. Save locally.</h2>
        </div>
        <div class="accuracy-note__copy">
          <p>
            Your active map autosaves in the browser. Download the project as a portable
            file when you want a durable backup or need to move it to another browser.
          </p>
          <a class="button button--citron" href="/editor/">Create a map for free</a>
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>
